ENVIRONMENT=development
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DB_HOST:5432/DB_NAME
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Official data.gov.in / AGMARKNET integration
DATA_GOV_API_KEY=YOUR_DATA_GOV_API_KEY
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# cv_demo works without trained weights. Use hybrid after training.
MODEL_MODE=cv_demo
QUALITY_MODEL_PATH=../ml/artifacts/quality_model.ts
DEFECT_MODEL_PATH=../ml/artifacts/defects/yolo11s-seg.pt

# Production object storage (recommended for Render/Railway/Cloud Run)
STORAGE_BACKEND=local
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=potato-inspections
INTERNAL_SERVICE_KEY=YOUR_INTERNAL_SERVICE_KEY
ADMIN_USER_IDS=USER_ID_1,USER_ID_2
ADMIN_EMAILS=admin@example.com
