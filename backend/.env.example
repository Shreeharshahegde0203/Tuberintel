ENVIRONMENT=development
DATABASE_URL=sqlite:///./tuberintel.db
FRONTEND_ORIGIN=http://localhost:5173

# Authentication. Keep demo for tomorrow; switch to supabase for verified phone OTP.
AUTH_MODE=demo

# Official data.gov.in / AGMARKNET integration
# Create a free key at data.gov.in and keep it in the backend only.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MARKET_CACHE_MINUTES=60
ANALYSIS_MARKET_MAX_AGE_DAYS=7
MARKET_PAGE_SIZE=500
MARKET_MAX_PAGES=8

# Validated operational potato-price forecasting (numeric horizon capped at 30 days)
PRICE_FORECAST_MODEL_PATH=../ml/artifacts/price_forecaster_v2.joblib
PRICE_FORECAST_MAX_HORIZON_DAYS=30
PRICE_FORECAST_MIN_HISTORY_DAYS=90
PRICE_FORECAST_HISTORY_DAYS=1825
PRICE_FORECAST_INTERVAL_LEVEL=0.80

# Potato-news RSS feeds (comma separated). The application stores only headlines,
# summaries and source links; it does not copy full articles.
POTATO_NEWS_FEEDS=https://news.google.com/rss/search?q=potato+India&hl=en-IN&gl=IN&ceid=IN:en,https://news.google.com/rss/search?q=potato+farmer+India&hl=en-IN&gl=IN&ceid=IN:en
NEWS_CACHE_MINUTES=90

# cv_demo works without trained weights. Use hybrid after training.
MODEL_MODE=cv_demo
QUALITY_MODEL_PATH=../ml/artifacts/quality_model.ts
DEFECT_MODEL_PATH=../ml/artifacts/defects/yolo11s-seg.pt

# Production object storage (recommended for Render/Railway/Cloud Run)
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=potato-inspections

# Maximum pages scanned when synchronizing a state's reporting-mandi directory.
MARKET_DIRECTORY_MAX_PAGES=80

# Optional Tuber Mitra LLM enhancement. Leave empty for the built-in grounded
# local assistant; no API key is required for the demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AGMARKNET_BASE_URL=https://api.agmarknet.gov.in/v1
AGMARKNET_TIMEOUT_SECONDS=30
AGMARKNET_SYNC_MONTHS=2
AGMARKNET_POTATO_COMMODITY_ID=24
