import {
  ArrowRight,
  BarChart3,
  Boxes,
  CloudRain,
  CloudSun,
  Droplets,
  History,
  IndianRupee,
  Landmark,
  MapPin,
  Newspaper,
  PackageCheck,
  ScanLine,
  Snowflake,
  Sun,
  ThermometerSun,
  TrendingDown,
  TrendingUp,
  Truck,
  Wind,
} from 'lucide-react'
import { useEffect, useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import { Area, AreaChart, CartesianGrid, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts'
import { ErrorState, LoadingState, StatusBadge } from '../components/Common'
import { useAuth } from '../auth/AuthContext'
import { useI18n } from '../i18n/I18nContext'
import { api, getDashboard, getMarketOverview } from '../services/api'
import { actionLabel, formatCurrency, formatDate, formatNumber } from '../services/format'
import type { DashboardSummary, MarketOverview } from '../types'

type WeatherData = {
  current_temperature: number | null
  current_humidity: number | null
  current_wind_speed: number | null
  current_weather_code: number | null
  daily: Array<{ date: string; minimum_temperature: number; maximum_temperature: number; precipitation_probability: number }>
  source: string
}

type NewsArticle = {
  id: number | string
  title: string
  category?: string
  source?: string
  published_at?: string | null
  url?: string
}

type NewsData = { articles: NewsArticle[] }

const coordinates: Record<string, { latitude: number; longitude: number; label: string }> = {
  Karnataka: { latitude: 12.9716, longitude: 77.5946, label: 'Bengaluru, Karnataka' },
  'Uttar Pradesh': { latitude: 27.1767, longitude: 78.0081, label: 'Agra, Uttar Pradesh' },
  Gujarat: { latitude: 23.0225, longitude: 72.5714, label: 'Ahmedabad, Gujarat' },
  'Madhya Pradesh': { latitude: 22.7196, longitude: 75.8577, label: 'Indore, Madhya Pradesh' },
  Punjab: { latitude: 30.901, longitude: 75.8573, label: 'Ludhiana, Punjab' },
  'West Bengal': { latitude: 22.5726, longitude: 88.3639, label: 'Kolkata, West Bengal' },
  Bihar: { latitude: 25.5941, longitude: 85.1376, label: 'Patna, Bihar' },
}

function weatherLabel(code: number | null, language: 'en' | 'kn') {
  if (code == null) return language === 'kn' ? 'ಹವಾಮಾನ ಸಂಪರ್ಕ ಬಾಕಿ' : 'Weather connection pending'
  if ([0, 1].includes(code)) return language === 'kn' ? 'ಸ್ವಚ್ಛ ವಾತಾವರಣ' : 'Clear sky'
  if ([2, 3].includes(code)) return language === 'kn' ? 'ಮೋಡ ಕವಿದಿದೆ' : 'Partly cloudy'
  if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return language === 'kn' ? 'ಮಳೆಯ ಸಾಧ್ಯತೆ' : 'Rain expected'
  return language === 'kn' ? 'ಬದಲಾಗುವ ಹವಾಮಾನ' : 'Variable weather'
}

function WeatherIcon({ code }: { code: number | null }) {
  if (code == null) return <CloudSun size={90} strokeWidth={1.25} />
  if ([0, 1].includes(code)) return <Sun size={90} strokeWidth={1.25} />
  if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return <CloudRain size={90} strokeWidth={1.25} />
  return <CloudSun size={90} strokeWidth={1.25} />
}

export default function DashboardPage() {
  const [dashboard, setDashboard] = useState<DashboardSummary | null>(null)
  const [market, setMarket] = useState<MarketOverview | null>(null)
  const [weather, setWeather] = useState<WeatherData | null>(null)
  const [news, setNews] = useState<NewsArticle[]>([])
  const [error, setError] = useState('')
  const { user } = useAuth()
  const { language, locale } = useI18n()
  const state = localStorage.getItem('tuberintel-location') || 'Karnataka'
  const selectedCoordinates = coordinates[state] || coordinates.Karnataka

  const copy = language === 'kn'
    ? {
        greetingMorning: 'ಶುಭೋದಯ', greetingAfternoon: 'ಶುಭ ಮಧ್ಯಾಹ್ನ', greetingEvening: 'ಶುಭ ಸಂಜೆ',
        subtitle: 'ಇಂದಿನ ಆಲೂಗಡ್ಡೆ ನಿರ್ಧಾರಗಳಿಗೆ ಬೇಕಾದ ಮುಖ್ಯ ಮಾಹಿತಿ ಒಂದೇ ಸ್ಥಳದಲ್ಲಿ.',
        weather: 'ಹವಾಮಾನ ಮತ್ತು ಬೆಳೆ ಅಪಾಯ', weatherPending: 'ಹವಾಮಾನ API ಮುಂದಿನ ಹಂತದಲ್ಲಿ ಸಂಪರ್ಕಿಸಲಾಗುತ್ತದೆ.',
        humidity: 'ಆರ್ದ್ರತೆ', wind: 'ಗಾಳಿಯ ವೇಗ', rain: 'ಮಳೆ ಸಾಧ್ಯತೆ',
        latestNews: 'ಇತ್ತೀಚಿನ ಆಲೂಗಡ್ಡೆ ಸುದ್ದಿ', viewAll: 'ಎಲ್ಲ ನೋಡಿ', noNews: 'ಸುದ್ದಿ ಫೀಡ್ ಮುಂದಿನ ಹಂತದಲ್ಲಿ ಸಂಪರ್ಕಿಸಲಾಗುತ್ತದೆ.',
        modal: 'ಇಂದಿನ ಸರಾಸರಿ ಮಾದರಿ ಬೆಲೆ', sevenDay: 'ಇತ್ತೀಚಿನ ಚಲನೆ', bestMarket: 'ಅತ್ಯುತ್ತಮ ಮಂಡಿ', batches: 'ವಿಶ್ಲೇಷಿಸಿದ ಬ್ಯಾಚ್‌ಗಳು',
        quickActions: 'ತ್ವರಿತ ಕಾರ್ಯಗಳು', quickText: 'ಮುಖ್ಯ ನಿರ್ಧಾರ ಸಾಧನಗಳಿಗೆ ನೇರ ಪ್ರವೇಶ',
        quality: 'ಗುಣಮಟ್ಟ ಪರಿಶೀಲನೆ', mandi: 'ಮಂಡಿ ಬೆಲೆ', analytics: 'ಬೆಲೆ ವಿಶ್ಲೇಷಣೆ', storage: 'ಸಂಗ್ರಹ ನಿರ್ಧಾರ', transport: 'ಸಾಗಣೆ ಲೆಕ್ಕ', newsAction: 'ಸುದ್ದಿ ಮತ್ತು ಯೋಜನೆಗಳು', history: 'ಬ್ಯಾಚ್ ಇತಿಹಾಸ', models: 'ಮಾದರಿಗಳು ಮತ್ತು ವಿಧಾನಗಳು', next: 'ಮುಂದಿನ ಹಂತ',
        topMarkets: 'ಇಂದಿನ ಪ್ರಮುಖ ಮಂಡಿಗಳು', priceTrend: 'ಬೆಲೆ ಪ್ರವೃತ್ತಿ', last30: 'ಮುಂದಿನ 30 ದಿನಗಳ ಸೂಚನೆ',
        recent: 'ಇತ್ತೀಚಿನ ಬ್ಯಾಚ್ ವಿಶ್ಲೇಷಣೆ', batch: 'ಬ್ಯಾಚ್', origin: 'ಮೂಲ', qualityCol: 'ಗುಣಮಟ್ಟ', decision: 'ನಿರ್ಧಾರ', profit: 'ನಿರೀಕ್ಷಿತ ಲಾಭ',
        noBatches: 'ಇನ್ನೂ ಬ್ಯಾಚ್ ವಿಶ್ಲೇಷಣೆ ಇಲ್ಲ.', start: 'ಮೊದಲ ಪರಿಶೀಲನೆ ಪ್ರಾರಂಭಿಸಿ', source: 'ಮೂಲ', preview: 'UI ಪೂರ್ವದೃಶ್ಯ',
      }
    : {
        greetingMorning: 'Good morning', greetingAfternoon: 'Good afternoon', greetingEvening: 'Good evening',
        subtitle: 'Everything needed for today’s potato decisions, in one clear workspace.',
        weather: 'Weather & crop risk', weatherPending: 'Weather API will be connected after the mandi UI phase.',
        humidity: 'Humidity', wind: 'Wind', rain: 'Rain chance',
        latestNews: 'Latest potato intelligence', viewAll: 'View all', noNews: 'The potato news feed will be connected in the next backend phase.',
        modal: "Today's average modal price", sevenDay: 'Recent movement', bestMarket: 'Best mandi', batches: 'Analysed batches',
        quickActions: 'Quick actions', quickText: 'Direct access to the main decision tools',
        quality: 'Quality check', mandi: 'Mandi prices', analytics: 'Price analytics', storage: 'Storage decision', transport: 'Transport estimate', newsAction: 'News & schemes', history: 'Batch history', models: 'Models & methods', next: 'Next phase',
        topMarkets: 'Top mandis today', priceTrend: 'Price trend', last30: '30-day price signal',
        recent: 'Recent batch analyses', batch: 'Batch', origin: 'Origin', qualityCol: 'Quality', decision: 'Decision', profit: 'Expected profit',
        noBatches: 'No batch analyses yet.', start: 'Start first inspection', source: 'Source', preview: 'UI preview',
      }

  const load = async () => {
    setError('')
    try {
      const [dashboardData, marketData] = await Promise.all([getDashboard(), getMarketOverview(state)])
      setDashboard(dashboardData)
      setMarket(marketData)

      const [weatherResult, newsResult] = await Promise.allSettled([
        api.get<WeatherData>('/weather', { params: { latitude: selectedCoordinates.latitude, longitude: selectedCoordinates.longitude, days: 5 } }),
        api.get<NewsData>('/news', { params: { limit: 4 } }),
      ])
      if (weatherResult.status === 'fulfilled') setWeather(weatherResult.value.data)
      if (newsResult.status === 'fulfilled') setNews(newsResult.value.data.articles || [])
    } catch (err: any) {
      setError(err?.response?.data?.detail || err.message)
    }
  }

  useEffect(() => { void load() }, [state])

  const hour = new Date().getHours()
  const greeting = hour < 12 ? copy.greetingMorning : hour < 17 ? copy.greetingAfternoon : copy.greetingEvening
  const firstName = user?.name?.split(' ')[0] || 'Farmer'

  const chartData = useMemo(() => {
    const forecast = market?.forecast?.length ? market.forecast : dashboard?.price_forecast || []
    return forecast.slice(0, 30).map((point) => ({ ...point, label: new Date(point.date).toLocaleDateString(locale, { day: 'numeric', month: 'short' }) }))
  }, [dashboard?.price_forecast, market?.forecast, locale])

  const topMarkets = useMemo(() => {
    if (!market) return []
    const latest = [...market.latest_prices]
    latest.sort((a, b) => b.modal_price - a.modal_price)
    return latest.slice(0, 5)
  }, [market])

  if (error) return <ErrorState message={String(error)} retry={() => void load()} />
  if (!dashboard || !market) return <LoadingState />

  const WeatherStatusIcon = weather?.current_weather_code != null && [51, 53, 55, 61, 63, 65, 80, 81, 82].includes(weather.current_weather_code) ? CloudRain : ThermometerSun
  const weatherRain = weather?.daily?.[0]?.precipitation_probability ?? null
  const trendNegative = market.change_percent < 0

  const quickActions = [
    { to: '/analyze', title: copy.quality, icon: ScanLine, active: true },
    { to: '/market', title: copy.mandi, icon: Landmark, active: true },
    { title: copy.analytics, icon: BarChart3, active: false },
    { title: copy.storage, icon: Snowflake, active: false },
    { title: copy.transport, icon: Truck, active: false },
    { title: copy.newsAction, icon: Newspaper, active: false },
    { to: '/history', title: copy.history, icon: History, active: true },
    { to: '/models', title: copy.models, icon: Boxes, active: true },
  ]

  return (
    <div className="pb-dashboard">
      <section className="pb-dashboard-heading">
        <div><h1>{greeting}, {firstName} <span aria-hidden="true">👋</span></h1><p><MapPin size={16} />{selectedCoordinates.label} · {copy.subtitle}</p></div>
        <Link to="/analyze" className="pb-primary-button"><PackageCheck size={18} />{copy.quality}</Link>
      </section>

      <section className="pb-dashboard-hero-grid">
        <article className="pb-weather-card">
          <div className="pb-weather-copy">
            <span className="pb-card-eyebrow"><WeatherStatusIcon size={16} />{copy.weather}</span>
            <h2>{weatherLabel(weather?.current_weather_code ?? null, language)}</h2>
            {weather?.current_temperature != null ? (
              <><div className="pb-weather-temperature">{Math.round(weather.current_temperature)}°<small>C</small></div><p>{selectedCoordinates.label}</p></>
            ) : <><div className="pb-weather-temperature pending">—°</div><p>{copy.weatherPending}</p></>}
            <div className="pb-weather-metrics">
              <div><Droplets size={18} /><span>{copy.humidity}</span><strong>{weather?.current_humidity == null ? '—' : `${Math.round(weather.current_humidity)}%`}</strong></div>
              <div><Wind size={18} /><span>{copy.wind}</span><strong>{weather?.current_wind_speed == null ? '—' : `${Math.round(weather.current_wind_speed)} km/h`}</strong></div>
              <div><CloudRain size={18} /><span>{copy.rain}</span><strong>{weatherRain == null ? '—' : `${Math.round(weatherRain)}%`}</strong></div>
            </div>
          </div>
          <div className="pb-weather-art"><WeatherIcon code={weather?.current_weather_code ?? null} /><span>{weather?.source || copy.preview}</span></div>
        </article>

        <article className="pb-news-rail">
          <div className="pb-card-title-row"><div><span>{copy.latestNews}</span><strong>{copy.source}: {news.length ? 'live feed' : copy.preview}</strong></div><Newspaper size={21} /></div>
          <div className="pb-news-list">
            {news.length ? news.slice(0, 4).map((article) => (
              <a href={article.url || '#'} target={article.url ? '_blank' : undefined} rel="noreferrer" key={article.id}>
                <span>{article.category || 'Potato update'}</span><strong>{article.title}</strong><small>{article.source || ''}{article.published_at ? ` · ${formatDate(article.published_at, language)}` : ''}</small>
              </a>
            )) : <div className="pb-news-empty"><Newspaper size={30} /><strong>{copy.noNews}</strong><small>{copy.next}</small></div>}
          </div>
        </article>
      </section>

      <section className="pb-market-summary-grid">
        <article><span className="pb-summary-icon green"><IndianRupee size={20} /></span><div><small>{copy.modal}</small><strong>{formatCurrency(dashboard.latest_modal_price, 0, language)} <em>/ qtl</em></strong></div></article>
        <article><span className={`pb-summary-icon ${trendNegative ? 'red' : 'green'}`}>{trendNegative ? <TrendingDown size={20} /> : <TrendingUp size={20} />}</span><div><small>{copy.sevenDay}</small><strong className={trendNegative ? 'negative' : 'positive'}>{market.change_percent >= 0 ? '+' : ''}{market.change_percent.toFixed(1)}%</strong></div></article>
        <article><span className="pb-summary-icon blue"><Landmark size={20} /></span><div><small>{copy.bestMarket}</small><strong>{market.best_market || '—'}</strong></div></article>
        <article><span className="pb-summary-icon amber"><Boxes size={20} /></span><div><small>{copy.batches}</small><strong>{formatNumber(dashboard.analyzed_batches, 0, language)}</strong></div></article>
      </section>

      <section className="pb-section-block">
        <div className="pb-section-heading"><div><h2>{copy.quickActions}</h2><p>{copy.quickText}</p></div></div>
        <div className="pb-quick-grid">
          {quickActions.map(({ to, title, icon: Icon, active }) => active && to ? (
            <Link to={to} className="pb-quick-card" key={title}><span><Icon size={25} /></span><strong>{title}</strong><ArrowRight size={17} /></Link>
          ) : (
            <div className="pb-quick-card disabled" key={title}><span><Icon size={25} /></span><strong>{title}</strong><small>{copy.next}</small></div>
          ))}
        </div>
      </section>

      <section className="pb-market-intelligence-grid">
        <article className="pb-panel pb-top-markets-panel">
          <div className="pb-panel-heading"><div><h2>{copy.topMarkets}</h2><p>{state}</p></div><Link to="/market">{copy.viewAll}<ArrowRight size={16} /></Link></div>
          <div className="pb-top-market-list">
            {topMarkets.map((item, index) => <div key={`${item.market}-${item.variety}-${index}`}><span>{index + 1}</span><div><strong>{item.market}</strong><small>{item.district} · {item.variety}</small></div><div><strong>{formatCurrency(item.modal_price, 0, language)}</strong><small>/ qtl</small></div></div>)}
          </div>
        </article>

        <article className="pb-panel pb-price-chart-panel">
          <div className="pb-panel-heading"><div><h2>{copy.priceTrend}</h2><p>{copy.last30}</p></div><Link to="/market">{copy.viewAll}<ArrowRight size={16} /></Link></div>
          <div className="pb-price-chart">
            <ResponsiveContainer width="100%" height="100%"><AreaChart data={chartData} margin={{ top: 8, right: 12, left: -10, bottom: 0 }}><defs><linearGradient id="pbPriceFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="#20a873" stopOpacity={0.28}/><stop offset="100%" stopColor="#20a873" stopOpacity={0.02}/></linearGradient></defs><CartesianGrid vertical={false} strokeDasharray="3 3" stroke="#e4ece8"/><XAxis dataKey="label" axisLine={false} tickLine={false}/><YAxis axisLine={false} tickLine={false} tickFormatter={(value) => `₹${Math.round(Number(value))}`}/><Tooltip formatter={(value) => [formatCurrency(Number(value), 0, language), copy.priceTrend]}/><Area type="monotone" dataKey="predicted_price" stroke="#17a36e" strokeWidth={2.5} fill="url(#pbPriceFill)"/></AreaChart></ResponsiveContainer>
          </div>
        </article>
      </section>

      <section className="pb-panel pb-recent-panel">
        <div className="pb-panel-heading"><div><h2>{copy.recent}</h2><p>{dashboard.recent_batches.length} {copy.batches.toLowerCase()}</p></div><Link to="/history">{copy.viewAll}<ArrowRight size={16} /></Link></div>
        {dashboard.recent_batches.length ? (
          <div className="pb-table-wrap"><table><thead><tr><th>{copy.batch}</th><th>{copy.origin}</th><th>{copy.qualityCol}</th><th>{copy.decision}</th><th>{copy.profit}</th><th/></tr></thead><tbody>{dashboard.recent_batches.slice(0, 5).map((batch) => <tr key={batch.id}><td><strong>{batch.batch_code}</strong><small>{batch.variety} · {formatDate(batch.created_at, language)}</small></td><td>{batch.source_location}</td><td>{batch.grade ? <span className={`grade-token grade-${batch.grade.toLowerCase()}`}>{batch.grade}</span> : '—'}</td><td><StatusBadge value={batch.action ? actionLabel(batch.action, language) : batch.status}/></td><td>{batch.expected_net_profit == null ? '—' : formatCurrency(batch.expected_net_profit, 0, language)}</td><td><Link to={`/batches/${batch.id}`}><ArrowRight size={18}/></Link></td></tr>)}</tbody></table></div>
        ) : <div className="pb-empty-row"><PackageCheck size={32}/><strong>{copy.noBatches}</strong><Link to="/analyze">{copy.start}<ArrowRight size={16}/></Link></div>}
      </section>
    </div>
  )
}
