import { Activity, ArrowRight, Boxes, IndianRupee, ScanLine, TrendingUp } from 'lucide-react'
import { useEffect, useState } from 'react'
import { Link } from 'react-router-dom'
import { CartesianGrid, Line, LineChart, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts'
import { EmptyState, ErrorState, LoadingState, PageHeader, StatCard, StatusBadge } from '../components/Common'
import { useI18n } from '../i18n/I18nContext'
import { getDashboard } from '../services/api'
import { actionLabel, formatCurrency, formatDate, formatNumber } from '../services/format'
import type { DashboardSummary } from '../types'

export default function DashboardPage() {
  const [data, setData] = useState<DashboardSummary | null>(null)
  const [error, setError] = useState('')
  const { language, locale, t } = useI18n()

  const load = () => {
    setError('')
    getDashboard().then(setData).catch((err) => setError(err?.response?.data?.detail || err.message))
  }
  useEffect(load, [])

  if (error) return <ErrorState message={String(error)} retry={load} />
  if (!data) return <LoadingState />

  const forecast = data.price_forecast.map((point) => ({ ...point, label: new Date(point.date).toLocaleDateString(locale, { day: '2-digit', month: 'short' }) }))
  return (
    <>
      <PageHeader eyebrow={t('dashboard.eyebrow')} title={t('dashboard.title')} description={t('dashboard.description')} actions={<Link to="/analyze" className="button button-primary"><ScanLine size={20} /> {t('dashboard.inspect')}</Link>} />
      <section className="stat-grid">
        <StatCard icon={Boxes} label={t('dashboard.registered')} value={formatNumber(data.total_batches, 0, language)} detail={t('dashboard.analysed', { count: data.analyzed_batches })} />
        <StatCard icon={Activity} label={t('dashboard.avgQuality')} value={`${formatNumber(data.average_quality_score, 1, language)} / 100`} detail={t('dashboard.completed')} tone={data.average_quality_score >= 70 ? 'positive' : 'warning'} />
        <StatCard icon={IndianRupee} label={t('dashboard.projected')} value={formatCurrency(data.projected_value, 0, language)} detail={t('dashboard.operatingProfit')} tone="positive" />
        <StatCard icon={TrendingUp} label={t('dashboard.modal')} value={`${formatCurrency(data.latest_modal_price, 0, language)} / qtl`} detail={t('dashboard.movement', { value: `${data.price_change_percent >= 0 ? '+' : ''}${data.price_change_percent.toFixed(1)}` })} />
      </section>

      <section className="dashboard-grid">
        <article className="panel chart-panel span-8">
          <div className="panel-heading"><div><span className="panel-kicker">{t('dashboard.marketOutlook')}</span><h2>{t('dashboard.priceSignal')}</h2></div><Link to="/market" className="text-link">{t('dashboard.openMarket')} <ArrowRight size={18} /></Link></div>
          <div className="chart-wrap"><ResponsiveContainer width="100%" height="100%"><LineChart data={forecast} margin={{ top: 10, right: 12, left: -12, bottom: 0 }}><CartesianGrid strokeDasharray="3 3" vertical={false} /><XAxis dataKey="label" tickLine={false} axisLine={false} minTickGap={24} /><YAxis tickLine={false} axisLine={false} tickFormatter={(v) => `₹${Math.round(v / 100) * 100}`} domain={['auto', 'auto']} /><Tooltip formatter={(value) => [formatCurrency(Number(value), 0, language), t('dashboard.predictedPrice')]} labelStyle={{ fontWeight: 700 }} /><Line type="monotone" dataKey="predicted_price" stroke="var(--green-700)" strokeWidth={2.5} dot={false} activeDot={{ r: 4 }} /></LineChart></ResponsiveContainer></div>
        </article>
        <article className="panel span-4">
          <div className="panel-heading"><div><span className="panel-kicker">{t('dashboard.decisionMix')}</span><h2>{t('dashboard.pathways')}</h2></div></div>
          <div className="decision-list">{Object.entries(data.action_distribution).map(([action, count]) => { const total = Math.max(1, data.analyzed_batches); return <div key={action} className="decision-row"><div><strong>{actionLabel(action, language)}</strong><span>{count} {t('common.batches')}</span></div><div className="mini-track"><span style={{ width: `${(count / total) * 100}%` }} /></div></div> })}</div>
          <div className="grade-summary">{Object.entries(data.grade_distribution).map(([grade, count]) => <div key={grade}><span className={`grade-token grade-${grade.toLowerCase()}`}>{grade}</span><strong>{count}</strong><small>{t('common.batches')}</small></div>)}</div>
        </article>
      </section>

      <section className="panel table-panel">
        <div className="panel-heading"><div><span className="panel-kicker">{t('dashboard.recent')}</span><h2>{t('dashboard.latest')}</h2></div><Link to="/history" className="text-link">{t('dashboard.viewAll')} <ArrowRight size={18} /></Link></div>
        {data.recent_batches.length === 0 ? <EmptyState title={t('dashboard.noBatches')} description={t('dashboard.noBatchesText')} actionLabel={t('dashboard.first')} actionTo="/analyze" /> : <div className="table-scroll"><table><thead><tr><th>{t('table.batch')}</th><th>{t('table.origin')}</th><th>{t('table.quantity')}</th><th>{t('table.quality')}</th><th>{t('table.decision')}</th><th>{t('table.profit')}</th><th /></tr></thead><tbody>{data.recent_batches.map((batch) => <tr key={batch.id}><td><strong>{batch.batch_code}</strong><span className="cell-subtitle">{batch.variety} · {formatDate(batch.created_at, language)}</span></td><td>{batch.source_location}</td><td>{formatNumber(batch.quantity_kg, 0, language)} kg</td><td>{batch.grade ? <div className="quality-cell"><span className={`grade-token grade-${batch.grade.toLowerCase()}`}>{batch.grade}</span><span>{batch.quality_score?.toFixed(1)}</span></div> : <StatusBadge value={batch.status} />}</td><td><StatusBadge value={batch.action ? actionLabel(batch.action, language) : batch.status} /></td><td>{batch.expected_net_profit == null ? '—' : formatCurrency(batch.expected_net_profit, 0, language)}</td><td><Link className="row-link" to={`/batches/${batch.id}`} aria-label={`Open ${batch.batch_code}`}><ArrowRight size={20} /></Link></td></tr>)}</tbody></table></div>}
      </section>
    </>
  )
}
