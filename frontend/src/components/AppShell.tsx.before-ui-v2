import {
  BarChart3,
  Bell,
  Boxes,
  ChevronDown,
  ClipboardList,
  Home,
  Languages,
  Landmark,
  Leaf,
  LogOut,
  Menu,
  Newspaper,
  PackageCheck,
  Search,
  Settings,
  Snowflake,
  Truck,
  UserRound,
  X,
} from 'lucide-react'
import { useMemo, useState, type FormEvent } from 'react'
import { NavLink, Outlet, useNavigate } from 'react-router-dom'
import { useAuth } from '../auth/AuthContext'
import { useI18n } from '../i18n/I18nContext'
import '../market-ui-phase1.css'

export function AppShell() {
  const [mobileOpen, setMobileOpen] = useState(false)
  const [profileOpen, setProfileOpen] = useState(false)
  const [query, setQuery] = useState('')
  const [location, setLocation] = useState(() => localStorage.getItem('tuberintel-location') || 'Karnataka')
  const { user, signOut } = useAuth()
  const { language, setLanguage } = useI18n()
  const navigate = useNavigate()

  const copy = language === 'kn'
    ? {
        overview: 'ಅವಲೋಕನ',
        inspect: 'ಗುಣಮಟ್ಟ ಪರಿಶೀಲನೆ',
        market: 'ಮಂಡಿ ಬೆಲೆ',
        history: 'ಬ್ಯಾಚ್ ಇತಿಹಾಸ',
        models: 'ಮಾದರಿಗಳು',
        analytics: 'ಬೆಲೆ ವಿಶ್ಲೇಷಣೆ',
        storage: 'ಸಂಗ್ರಹ ನಿರ್ಧಾರ',
        transport: 'ಸಾಗಣೆ ಲೆಕ್ಕ',
        news: 'ಸುದ್ದಿ ಮತ್ತು ಯೋಜನೆಗಳು',
        search: 'ಮಂಡಿ, ತಳಿ, ಸುದ್ದಿ ಹುಡುಕಿ…',
        location: 'ಆಯ್ದ ರಾಜ್ಯ',
        account: 'ನನ್ನ ಖಾತೆ',
        signOut: 'ಸೈನ್ ಔಟ್',
        more: 'ಇನ್ನಷ್ಟು',
      }
    : {
        overview: 'Overview',
        inspect: 'Quality check',
        market: 'Mandi prices',
        history: 'Batch history',
        models: 'Models & methods',
        analytics: 'Price analytics',
        storage: 'Storage decision',
        transport: 'Transport estimate',
        news: 'News & schemes',
        search: 'Search mandis, varieties, news…',
        location: 'Selected state',
        account: 'My account',
        signOut: 'Sign out',
        more: 'More',
      }

  const primaryNav = useMemo(() => [
    { to: '/', label: copy.overview, icon: Home },
    { to: '/market', label: copy.market, icon: Landmark },
    { to: '/analyze', label: copy.inspect, icon: PackageCheck },
    { to: '/history', label: copy.history, icon: ClipboardList },
    { to: '/models', label: copy.models, icon: Boxes },
  ], [copy.overview, copy.market, copy.inspect, copy.history, copy.models])

  const upcomingNav = [
    { label: copy.analytics, icon: BarChart3 },
    { label: copy.storage, icon: Snowflake },
    { label: copy.transport, icon: Truck },
    { label: copy.news, icon: Newspaper },
  ]

  const submitSearch = (event: FormEvent) => {
    event.preventDefault()
    const value = query.trim()
    if (!value) return
    navigate(`/market?search=${encodeURIComponent(value)}`)
    setQuery('')
  }

  const chooseLocation = (value: string) => {
    setLocation(value)
    localStorage.setItem('tuberintel-location', value)
    window.dispatchEvent(new CustomEvent('tuberintel-location', { detail: value }))
  }

  return (
    <div className="pb-app-shell">
      <header className="pb-header">
        <div className="pb-header-top">
          <button className="pb-mobile-menu" type="button" onClick={() => setMobileOpen(true)} aria-label="Open menu">
            <Menu size={23} />
          </button>

          <NavLink to="/" className="pb-brand" aria-label="TuberIntel home">
            <span className="pb-brand-mark"><Leaf size={24} /></span>
            <span><strong>TuberIntel</strong><small>Potato decision intelligence</small></span>
          </NavLink>

          <label className="pb-location-picker">
            <Landmark size={18} />
            <span><small>{copy.location}</small>
              <select value={location} onChange={(event) => chooseLocation(event.target.value)}>
                <option>Karnataka</option>
                <option>Uttar Pradesh</option>
                <option>Gujarat</option>
                <option>Madhya Pradesh</option>
                <option>Punjab</option>
                <option>West Bengal</option>
                <option>Bihar</option>
              </select>
            </span>
            <ChevronDown size={16} />
          </label>

          <form className="pb-global-search" onSubmit={submitSearch}>
            <Search size={19} />
            <input value={query} onChange={(event) => setQuery(event.target.value)} placeholder={copy.search} />
          </form>

          <div className="pb-header-actions">
            <button className="pb-icon-button" type="button" title="Notifications"><Bell size={20} /><span className="pb-notification-dot" /></button>
            <div className="pb-profile-wrap">
              <button className="pb-profile-button" type="button" onClick={() => setProfileOpen((value) => !value)}>
                {user?.avatarUrl ? <img src={user.avatarUrl} alt="" /> : <span><UserRound size={20} /></span>}
                <div><strong>{user?.name || 'TuberIntel user'}</strong><small>{user?.email || copy.account}</small></div>
                <ChevronDown size={16} />
              </button>
              {profileOpen && (
                <div className="pb-profile-popover">
                  <div className="pb-profile-summary">
                    {user?.avatarUrl ? <img src={user.avatarUrl} alt="" /> : <span><UserRound size={22} /></span>}
                    <div><strong>{user?.name || 'TuberIntel user'}</strong><small>{user?.email}</small></div>
                  </div>
                  <button type="button" onClick={() => setLanguage(language === 'en' ? 'kn' : 'en')}><Languages size={17} />{language === 'en' ? 'ಕನ್ನಡ' : 'English'}</button>
                  <NavLink to="/models" onClick={() => setProfileOpen(false)}><Settings size={17} />{copy.models}</NavLink>
                  <button className="danger" type="button" onClick={() => void signOut()}><LogOut size={17} />{copy.signOut}</button>
                </div>
              )}
            </div>
          </div>
        </div>

        <nav className="pb-primary-nav" aria-label="Primary navigation">
          <div className="pb-primary-nav-inner">
            {primaryNav.map(({ to, label, icon: Icon }) => (
              <NavLink key={to} to={to} end={to === '/'}><Icon size={17} /><span>{label}</span></NavLink>
            ))}
            <div className="pb-more-menu">
              <button type="button"><Menu size={17} /><span>{copy.more}</span><ChevronDown size={15} /></button>
              <div className="pb-more-popover">
                {upcomingNav.map(({ label, icon: Icon }) => <span key={label}><Icon size={17} />{label}<small>Next phase</small></span>)}
              </div>
            </div>
          </div>
        </nav>
      </header>

      <aside className={`pb-mobile-drawer ${mobileOpen ? 'open' : ''}`}>
        <div className="pb-mobile-drawer-head">
          <div className="pb-brand"><span className="pb-brand-mark"><Leaf size={22} /></span><span><strong>TuberIntel</strong><small>Potato decision intelligence</small></span></div>
          <button type="button" onClick={() => setMobileOpen(false)}><X size={22} /></button>
        </div>
        <nav>
          {primaryNav.map(({ to, label, icon: Icon }) => <NavLink key={to} to={to} end={to === '/'} onClick={() => setMobileOpen(false)}><Icon size={19} />{label}</NavLink>)}
          {upcomingNav.map(({ label, icon: Icon }) => <span className="disabled" key={label}><Icon size={19} />{label}<small>Next</small></span>)}
        </nav>
        <button className="pb-drawer-signout" type="button" onClick={() => void signOut()}><LogOut size={18} />{copy.signOut}</button>
      </aside>
      {mobileOpen && <button className="pb-drawer-backdrop" type="button" aria-label="Close menu" onClick={() => setMobileOpen(false)} />}

      <main className="pb-main"><Outlet /></main>

      <nav className="pb-mobile-bottom-nav" aria-label="Mobile navigation">
        {primaryNav.slice(0, 4).map(({ to, label, icon: Icon }) => <NavLink key={to} to={to} end={to === '/'}><Icon size={20} /><span>{label}</span></NavLink>)}
        <button type="button" onClick={() => setMobileOpen(true)}><Menu size={20} /><span>{copy.more}</span></button>
      </nav>
    </div>
  )
}
